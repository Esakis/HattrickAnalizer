<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Backend\HattrickAnalizer.csproj" />
  </ItemGroup>
  <Target Name="RemovePrivateApiArtifactsFromBenchmarkOutput" AfterTargets="Build">
    <ItemGroup>
      <_BenchmarkSensitiveFiles Include="$(TargetDir)oauth_tokens.json" />
      <_BenchmarkSensitiveFiles Include="$(TargetDir)appsettings*.json" />
    </ItemGroup>
    <Delete Files="@(_BenchmarkSensitiveFiles)" />
  </Target>
</Project>
